# Morgen API key — get one at https://platform.morgen.so/developers-api
MORGEN_API_KEY=

# IANA timezone for calendar operations (default: America/New_York)
MORGEN_TIMEZONE=America/New_York

# Logical account used when MORGEN_ACCOUNT_ROUTES has no domain/keyword match
MORGEN_DEFAULT_ACCOUNT=default

# Optional JSON routing map. Keys are logical account names accepted by create_event.account.
# Supported route fields: domains, keywords, calendar_patterns, calendar_id.
MORGEN_ACCOUNT_ROUTES={"work":{"domains":["@example.com"],"keywords":["work"],"calendar_patterns":["work@example.com"]}}
